# Kopiera denna fil till .env.local och fyll i värdena från ditt Supabase-projekt
# (Project Settings → API i Supabase-dashboarden).

NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Endast för serversidan (webhooks m.m.) — dela ALDRIG med klienten.
SUPABASE_SERVICE_ROLE_KEY=

# Stripe (Developers → API keys i Stripe-dashboarden)
STRIPE_SECRET_KEY=
# Pris-ID för premium-prenumerationen, 149 kr/mån (Product catalog → skapa produkt → kopiera Price ID, börjar med price_)
STRIPE_PRICE_ID=
# Pris-ID för samma Premium-produkt fast årsvis, 1341 kr/år (149 kr/mån × 12 med 25% rabatt) — skapa som ett andra pris (recurring, yearly) på samma produkt i Stripe
STRIPE_PRICE_ID_YEARLY=
# Developers → Webhooks → lägg till endpoint https://din-domän/api/stripe/webhook → kopiera Signing secret
STRIPE_WEBHOOK_SECRET=

# Pushover — push-notis till telefonen när ett nytt lead kommer in via
# /coaching-anmalan. Skapa en Application på pushover.net/apps/build för
# API-token, och hämta User Key från din egen pushover.net-dashboard.
PUSHOVER_API_TOKEN=
PUSHOVER_USER_KEY=

# Meta Conversions API — server-till-server Lead-event till Meta för
# annonsoptimering. Pixel-ID + ett Conversions API-token skapas i
# Events Manager → din pixel → Settings → Conversions API.
META_CONVERSIONS_API_TOKEN=
META_PIXEL_ID=

# Delad hemlighet för /api/leads/meta — tar emot leads från Metas
# "Snabba formulär"-annonser (Instant Form) via en Zapier/Make-automation,
# eftersom de annonserna aldrig länkar till hemsidan och därför inte går
# genom /coaching-anmalan. Valfri lång slumpad sträng, samma värde måste
# anges i webhook-anropets Authorization-header ("Bearer <värde>").
META_LEAD_WEBHOOK_SECRET=
