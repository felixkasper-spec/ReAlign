# Kopiera denna fil till .env.local och fyll i värdena från ditt Supabase-projekt
# (Project Settings → API i Supabase-dashboarden).

NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Endast för serversidan (webhooks m.m.) — dela ALDRIG med klienten.
SUPABASE_SERVICE_ROLE_KEY=

# Stripe (Developers → API keys i Stripe-dashboarden)
STRIPE_SECRET_KEY=
# Pris-ID för premium-prenumerationen, 149 kr/mån (Product catalog → skapa produkt → kopiera Price ID, börjar med price_)
STRIPE_PRICE_ID=
# Pris-ID för samma Premium-produkt fast årsvis, 1341 kr/år (149 kr/mån × 12 med 25% rabatt) — skapa som ett andra pris (recurring, yearly) på samma produkt i Stripe
STRIPE_PRICE_ID_YEARLY=
# Developers → Webhooks → lägg till endpoint https://din-domän/api/stripe/webhook → kopiera Signing secret
STRIPE_WEBHOOK_SECRET=
